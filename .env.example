# Copy to .env and fill in the values. .env is gitignored.
#
# To load into your shell before running the app:
#   set -a && source .env && set +a && ./mvnw spring-boot:run
#
# docker compose picks .env up automatically from the project root.

# --- Database (also read by compose.yaml) ---
NAHERO_DB=nahero
NAHERO_DB_USER=nahero
NAHERO_DB_HOST=localhost
POSTGRES_PASSWORD=changeme

# --- Auth ---
# Any long random string; used to sign JWTs.
NAHERO_JWT_TOKEN=changeme-generate-a-long-random-string

# --- SSL (only needed if server.ssl.enabled=true) ---
SSL_PASSWORD=

# --- Stripe ---
# Secret key from Dashboard -> Developers -> API keys (sk_test_... in test mode).
STRIPE_API_KEY=sk_test_...

# Webhook signing secret. In local dev, use the whsec_... printed by:
#   stripe listen --forward-to localhost:8080/api/v1/payment/stripe
# In prod, copy from Dashboard -> Developers -> Webhooks -> your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring Price IDs from Dashboard -> Product catalog -> your product.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Where Stripe Checkout redirects the user after success/cancel.
STRIPE_SUCCESS_URL=http://localhost:3000/premium/success
STRIPE_CANCEL_URL=http://localhost:3000/premium/cancel

# --- Payment reconciliation (provider-agnostic) ---
# All optional; sensible defaults live in application.properties. Uncomment to override.
#PAYMENT_RECONCILE_ENABLED=true
#PAYMENT_RECONCILE_LOOKBACK_HOURS=24
#PAYMENT_RECONCILE_FIXED_DELAY_MS=900000
#PAYMENT_RECONCILE_INITIAL_DELAY_MS=60000
#PAYMENT_RECONCILE_MAX_ATTEMPTS=5

NAHERO_SMTP_INGRESS_ENDPOINT_NAME=
NAHERO_SMTP_USERNAME=
NAHERO_SMTP_PORT=
NAHERO_SMTP_PASSWORD=
NAHERO_SMTP_HOST=
